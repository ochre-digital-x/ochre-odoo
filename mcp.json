{
  "mcpServers": {
    "odoo": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/ochre-digital-x/ochre-odoo@main#subdirectory=server", "ochre-odoo-mcp"],
      "env": {
        "ODOO_URL": "${ODOO_URL}",
        "ODOO_DB": "${ODOO_DB}",
        "ODOO_USERNAME": "${ODOO_USERNAME}",
        "ODOO_API_KEY": "${ODOO_API_KEY}",
        "ODOO_ALLOW_WRITE": "${ODOO_ALLOW_WRITE}"
      }
    }
  }
}
